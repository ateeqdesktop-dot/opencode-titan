  ],
  "keywords": ["opencode", "plugin", "multi-agent", "orchestration", "ai"],
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "2.2.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test test",
    "build": "tsc -p tsconfig.build.json"
  },
  "engines": {
    "opencode": ">=2.0.0"
  }
